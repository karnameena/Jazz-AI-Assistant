{
  "name": "jazz-ai-assistant",
  "private": true,
  "version": "0.2.0",
  "description": "Modular privacy-first personal AI assistant platform",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --recursive --if-present dev",
    "build": "pnpm --recursive --if-present build",
    "test": "node --test tests/*.test.mjs && pnpm --recursive --if-present test",
    "test:foundation": "node --test tests/foundation.test.mjs",
    "lint": "pnpm --recursive --if-present lint"
  }
}
