{
  "name": "jazz-ai-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "Modular personal AI assistant platform",
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --recursive --if-present dev",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "lint": "pnpm --recursive --if-present lint",
    "lost-mode:migrate": "pnpm --filter @jazz/lost-mode-server migrate",
    "lost-mode:create-owner": "pnpm --filter @jazz/lost-mode-server create-owner",
    "lost-mode:create-device": "pnpm --filter @jazz/lost-mode-server create-device",
    "lost-mode:server": "pnpm --filter @jazz/lost-mode-server start",
    "lost-mode:web": "pnpm --filter @jazz/lost-mode-web dev"
  }
}
