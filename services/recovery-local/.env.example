# Copy this file to services/recovery-local/.env on the Jazz PC.
# Never commit the real owner token.
JAZZ_RECOVERY_LOCAL_PORT=8799
JAZZ_RECOVERY_RELAY_URL=https://your-recovery-relay.example.com
# Safe localhost-only fallback used when the hosted relay/tunnel is temporarily unavailable.
JAZZ_RECOVERY_LOCAL_RELAY_URL=http://127.0.0.1:8788
JAZZ_RECOVERY_OWNER_TOKEN=replace-with-the-same-owner-token-configured-on-the-relay
