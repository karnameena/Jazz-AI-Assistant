# Jazz Telegram Bot popup configuration.
# Copy the values you use into services/api/.env on your PC.
# Never commit the real bot token, API hash, or Telegram session string.
#
# This configuration is used ONLY by Quick Actions -> Telegram Bot.
# Normal Jazz chat continues through /api/chat, scripts, and Ollama.

JAZZ_TELEGRAM_BOT_USERNAME=Karnacam_bot
JAZZ_TELEGRAM_BOT_TOKEN=123456789:replace_with_your_botfather_token

# Telegram user-session credentials from https://my.telegram.org
JAZZ_TELEGRAM_API_ID=12345678
JAZZ_TELEGRAM_API_HASH=replace_with_your_api_hash

# Generate this locally with:
# pnpm --filter @jazz/web telegram:login
JAZZ_TELEGRAM_SESSION=replace_with_your_private_string_session
