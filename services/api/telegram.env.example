# Jazz Telegram popup configuration.
# Copy the values you use into services/api/.env on your PC.
# NEVER commit the real bot token, API hash, or Telegram StringSession.
#
# This configuration is used only by Quick Actions -> Telegram.
# Normal Jazz chat continues through /api/chat, scripts, Ollama and the ADB bridge.

JAZZ_TELEGRAM_BOT_USERNAME=Karnacam_bot

# Optional: used to resolve/verify the bot identity with Telegram Bot API.
# The real conversation itself is sent through your authorized Telegram user session.
JAZZ_TELEGRAM_BOT_TOKEN=123456789:replace_with_your_botfather_token

# Telegram application credentials from my.telegram.org.
JAZZ_TELEGRAM_API_ID=12345678
JAZZ_TELEGRAM_API_HASH=replace_with_your_api_hash

# Generate the private user session locally with:
# pnpm --filter @jazz/web telegram:login
JAZZ_TELEGRAM_SESSION=replace_with_your_private_string_session

# Optional. Jazz loads this many messages when the Telegram chat opens.
# Allowed range: 20-300. Default: 150.
JAZZ_TELEGRAM_HISTORY_LIMIT=150
