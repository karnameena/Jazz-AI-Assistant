PORT=8787

# Frontier AI brain (OpenAI Responses API + live web search)
# Copy these into services/api/.env for local use.
# JAZZ_LLM_API_URL=https://api.openai.com/v1/responses
# JAZZ_LLM_API_KEY=your-openai-api-key
# JAZZ_LLM_MODEL=gpt-5.6-sol
# JAZZ_REASONING_EFFORT=high

# Optional OpenAI-compatible chat-completions provider
# JAZZ_LLM_API_URL=https://your-provider.example/v1/chat/completions
# JAZZ_LLM_API_KEY=your-key
# JAZZ_LLM_MODEL=your-model

# Local Piper TTS
# Defaults to tools/piper/piper.exe and tools/piper/voices/en_US-amy-medium.onnx
# Set these only if you keep Piper somewhere else.
# JAZZ_PIPER_ROOT=../../tools/piper
# JAZZ_PIPER_BIN=../../tools/piper/piper.exe
# JAZZ_PIPER_MODEL=../../tools/piper/voices/en_US-amy-medium.onnx
