# Jazz API / web integration environment example
# Copy to: services/api/.env
#
# IMPORTANT:
# - start-jazz.ps1 deliberately does NOT load this file into the managed API process.
#   The launcher pins the managed API to port 8797 + local Ollama and validates Piper.
# - This file is still useful for manual API development and Telegram popup settings.
# - NEVER commit real API keys, Telegram tokens, API hashes, or StringSession values.

# -----------------------------------------------------------------------------
# Manual API development only
# -----------------------------------------------------------------------------
PORT=8797
JAZZ_ADB_BRIDGE_URL=http://127.0.0.1:9899

# -----------------------------------------------------------------------------
# Local Ollama brain (recommended)
# -----------------------------------------------------------------------------
JAZZ_LLM_PROVIDER=ollama
JAZZ_OLLAMA_URL=http://127.0.0.1:11434

# Leave empty to let Jazz prefer installed models in this order:
# qwen3:8b -> qwen3:1.7b -> qwen3:0.6b -> qwen2.5:7b -> first installed model
JAZZ_OLLAMA_MODEL=
JAZZ_OLLAMA_FALLBACK_MODEL=qwen2.5:7b
JAZZ_OLLAMA_AUTOSTART=true
JAZZ_OLLAMA_FALLBACK=true
JAZZ_OLLAMA_BIN=ollama
JAZZ_OLLAMA_TEMPERATURE=0.45
JAZZ_OLLAMA_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Local Piper TTS
# Normally no override is needed. Run tools/piper/setup-windows.ps1 and Jazz uses
# tools/piper/runtime/piper.exe + tools/piper/voices/en_US-amy-medium.onnx.
# -----------------------------------------------------------------------------
JAZZ_PIPER_PREWARM=false
JAZZ_PIPER_LENGTH_SCALE=0.88
# JAZZ_PIPER_ROOT=C:\path\to\Jazz-AI-Assistant\tools\piper
# JAZZ_PIPER_BIN=C:\path\to\Jazz-AI-Assistant\tools\piper\runtime\piper.exe
# JAZZ_PIPER_MODEL=C:\path\to\Jazz-AI-Assistant\tools\piper\voices\en_US-amy-medium.onnx
# JAZZ_PIPER_ESPEAK_DATA=C:\path\to\Jazz-AI-Assistant\tools\piper\runtime\espeak-ng-data

# -----------------------------------------------------------------------------
# Local Whisper STT overrides (normally not needed)
# start-jazz.ps1 launches the STT service on 8798 automatically.
# -----------------------------------------------------------------------------
JAZZ_STT_PORT=8798
JAZZ_STT_MAX_AUDIO_BYTES=12582912
JAZZ_WHISPER_THREADS=4
# JAZZ_WHISPER_BIN=C:\path\to\Jazz-AI-Assistant\tools\whisper\runtime\whisper-cli.exe
# JAZZ_WHISPER_MODEL=C:\path\to\Jazz-AI-Assistant\tools\whisper\models\ggml-base.en-q5_1.bin

# -----------------------------------------------------------------------------
# OPTIONAL online provider examples
# Managed start-jazz.ps1 still forces Ollama; use these only for manual API dev.
# -----------------------------------------------------------------------------
# JAZZ_LLM_PROVIDER=gemini
# JAZZ_LLM_API_KEY=replace_me
# JAZZ_LLM_MODEL=replace_me
# JAZZ_GEMINI_THINKING_LEVEL=high
# JAZZ_MAX_OUTPUT_TOKENS=8000
# JAZZ_GEMINI_ENABLE_WEB_SEARCH=false

# JAZZ_LLM_PROVIDER=openai
# JAZZ_LLM_API_URL=https://api.openai.com/v1/responses
# JAZZ_LLM_API_KEY=replace_me
# JAZZ_LLM_MODEL=replace_me
# JAZZ_REASONING_EFFORT=high

# -----------------------------------------------------------------------------
# Telegram popup integration
# See services/api/telegram.env.example for the full explanation.
# Copy only your private values here; never commit the real file.
# -----------------------------------------------------------------------------
# JAZZ_TELEGRAM_BOT_USERNAME=your_bot_username
# JAZZ_TELEGRAM_BOT_TOKEN=replace_me
# JAZZ_TELEGRAM_API_ID=12345678
# JAZZ_TELEGRAM_API_HASH=replace_me
# JAZZ_TELEGRAM_SESSION=replace_me
# JAZZ_TELEGRAM_HISTORY_LIMIT=150
