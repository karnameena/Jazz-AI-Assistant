# Jazz AI Assistant — local/private-first defaults
PORT=8787
JAZZ_API_HOST=127.0.0.1

# Default brain: Ollama running locally. No subscription/API key required.
JAZZ_LLM_PROVIDER=ollama
JAZZ_LLM_BASE_URL=http://127.0.0.1:11434
JAZZ_LLM_MODEL=qwen3:8b
JAZZ_LLM_TIMEOUT_MS=120000

# Default speech: local Piper. No subscription/API key required.
JAZZ_TTS_PROVIDER=piper
# Defaults to tools/piper/piper.exe and tools/piper/voices/en_US-amy-medium.onnx.
# JAZZ_PIPER_ROOT=../../tools/piper
# JAZZ_PIPER_BIN=../../tools/piper/piper.exe
# JAZZ_PIPER_MODEL=../../tools/piper/voices/en_US-amy-medium.onnx

# Security / observability
JAZZ_CONFIRM_HIGH_RISK=true
JAZZ_AUDIT_ENABLED=true
JAZZ_ADB_BRIDGE_URL=http://127.0.0.1:9899

# Android devices — configure locally; never commit real tokens.
# JAZZ_ANDROID_PHONE_SERIAL=
# JAZZ_ANDROID_PHONE_TOKEN=
# JAZZ_ANDROID_TABLET_SERIAL=
# JAZZ_ANDROID_TABLET_TOKEN=

# Optional future cloud providers may be configured by the user, but Jazz does not
# require any paid/subscription API for its default architecture.
# JAZZ_LLM_PROVIDER=openai-compatible
# JAZZ_LLM_API_URL=
# JAZZ_LLM_API_KEY=
