PORT=8787

# LOCAL-FIRST JAZZ BRAIN (recommended, no subscription)
# Ollama runs on your own PC. If Ollama is installed, Jazz can auto-start `ollama serve`.
JAZZ_LLM_PROVIDER=ollama
JAZZ_OLLAMA_URL=http://127.0.0.1:11434
# Leave JAZZ_OLLAMA_MODEL empty to use the first installed Ollama model.
# JAZZ_OLLAMA_MODEL=qwen2.5:7b
JAZZ_OLLAMA_FALLBACK_MODEL=qwen2.5:7b
JAZZ_OLLAMA_AUTOSTART=true
JAZZ_OLLAMA_FALLBACK=true

# Optional Gemini provider. If Gemini fails, Jazz falls back to local Ollama unless
# JAZZ_OLLAMA_FALLBACK=false.
# JAZZ_LLM_PROVIDER=gemini
# JAZZ_LLM_API_KEY=your-gemini-api-key
# JAZZ_LLM_MODEL=your-gemini-model
# JAZZ_GEMINI_THINKING_LEVEL=high
# JAZZ_MAX_OUTPUT_TOKENS=8000
# JAZZ_GEMINI_ENABLE_WEB_SEARCH=false

# Optional OpenAI-compatible provider. Online-provider failure also falls back to Ollama.
# JAZZ_LLM_PROVIDER=openai
# JAZZ_LLM_API_URL=https://api.openai.com/v1/responses
# JAZZ_LLM_API_KEY=your-api-key
# JAZZ_LLM_MODEL=your-model
# JAZZ_REASONING_EFFORT=high

# Local Piper TTS
# The API now resolves these from the repository root no matter which folder starts Node.
# Run tools/piper/setup-windows.ps1 once if piper.exe / Amy voice are missing.
# JAZZ_PIPER_ROOT=../../tools/piper
# JAZZ_PIPER_BIN=../../tools/piper/piper.exe
# JAZZ_PIPER_MODEL=../../tools/piper/voices/en_US-amy-medium.onnx
# JAZZ_PIPER_ESPEAK_DATA=../../tools/piper/piper/espeak-ng-data
