# Dedicated local coding model. This is separate from Jazz's normal chat/voice model.
JAZZ_CODING_PROVIDER=ollama
JAZZ_CODING_MODEL=qwen2.5-coder:7b
JAZZ_CODING_OLLAMA_URL=http://127.0.0.1:11434
JAZZ_CODING_CONTEXT=32768
JAZZ_CODING_MAX_TOKENS=8192
JAZZ_CODING_MAX_REPAIR_ATTEMPTS=3

# Optional overrides. Defaults already point inside .jazz/ and are gitignored.
# JAZZ_CODING_WORKSPACE_ROOT=C:\path\to\approved\coding-workspaces
# JAZZ_CODING_STATE_ROOT=C:\path\to\approved\coding-state
