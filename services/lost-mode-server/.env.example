PORT=8890
LOST_MODE_DB_PATH=./data/lost-mode.db
LOST_MODE_SESSION_TTL_MINUTES=30

# Browser origins allowed to call the Lost Mode API. Use exact origins only.
# Multiple origins can be comma-separated. Never use * with credentialed requests.
LOST_MODE_PUBLIC_ORIGINS=http://localhost:5190

# Local development can remain false/Strict. On Render or other HTTPS production
# hosting, cookies auto-default to Secure + SameSite=None. These explicit values
# are shown so production configuration is unambiguous.
LOST_MODE_COOKIE_SECURE=false
LOST_MODE_COOKIE_SAMESITE=Strict

# Trust X-Forwarded-For only behind a trusted reverse proxy. Render is detected
# automatically; set this explicitly when using another trusted proxy.
LOST_MODE_TRUST_PROXY=false

# Production example (set these in your hosting dashboard, not in Git):
# NODE_ENV=production
# LOST_MODE_PUBLIC_ORIGINS=https://your-lost-mode-web.example
# LOST_MODE_COOKIE_SECURE=true
# LOST_MODE_COOKIE_SAMESITE=None
# LOST_MODE_TRUST_PROXY=true

# Never put real usernames, passwords, device credentials, or session tokens here.
