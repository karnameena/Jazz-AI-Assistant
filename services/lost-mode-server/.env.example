PORT=8890
LOST_MODE_DB_PATH=./data/lost-mode.db
LOST_MODE_SESSION_TTL_MINUTES=30
LOST_MODE_COOKIE_SECURE=false
LOST_MODE_PUBLIC_ORIGIN=http://localhost:5190

# Optional: enable voice-command transcription using the existing Jazz STT service.
# Leave empty to keep transcription disabled. Audio-message recording still works.
# When both services run on the same machine, use http://127.0.0.1:8798
# Set this in the server process environment; never expose the STT service publicly.
LOST_MODE_STT_URL=

# Set true only behind HTTPS in production.
# Never put real credentials or session secrets in this example file.
