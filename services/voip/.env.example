# Copy this file to services/voip/.env and fill values locally.
# Never commit services/voip/.env with real credentials.

JAZZ_VOIP_ENABLED=true

# Asterisk REST Interface (ARI)
JAZZ_ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
JAZZ_ASTERISK_ARI_USER=jazz
JAZZ_ASTERISK_ARI_PASSWORD=replace-with-a-strong-local-password
JAZZ_ASTERISK_ARI_APP=jazz-reminder

# SIP endpoint Jazz calls for reminders.
# Example: extension 7001 registered by a SIP softphone on your Android phone.
JAZZ_ASTERISK_ENDPOINT=PJSIP/7001
JAZZ_VOIP_CALLER_ID=Jazz <7000>
JAZZ_VOIP_RING_TIMEOUT_SECONDS=35

# URL Asterisk itself can use to fetch Jazz reminder audio.
# If Asterisk runs on the same host, 127.0.0.1 may work.
# If Asterisk runs in WSL/Docker/a different machine, set this to the Jazz PC IP/host that Asterisk can reach.
JAZZ_VOIP_AUDIO_BASE_URL=http://127.0.0.1:8797

# Jazz currently runs in Chennai/India by default.
JAZZ_TIMEZONE=Asia/Kolkata
JAZZ_TIMEZONE_OFFSET_MINUTES=330
