# Deploy services/recovery-relay to an HTTPS host such as Render.
# Never commit real tokens.
PORT=8788
JAZZ_RECOVERY_DEVICE_ID=jazz-phone-main
JAZZ_RECOVERY_DEVICE_TOKEN=replace-with-token-copied-from-android-companion
JAZZ_RECOVERY_OWNER_TOKEN=replace-with-a-different-long-random-owner-token
JAZZ_RECOVERY_MAX_CLOCK_SKEW_MS=300000
JAZZ_RECOVERY_ONLINE_WINDOW_MS=90000
