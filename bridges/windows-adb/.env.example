# Jazz Windows ADB bridge configuration
# Copy this file to: bridges/windows-adb/.env
# NEVER commit your real bridge token(s).

# Full path to adb.exe is recommended on Windows.
# Example:
# ADB_PATH=C:\Users\YOUR_NAME\Downloads\platform-tools\adb.exe
ADB_PATH=C:\path\to\platform-tools\adb.exe

# Bridge listens only on localhost by default.
JAZZ_ADB_BRIDGE_PORT=9899
JAZZ_ADB_RECONNECT_INTERVAL_MS=10000

# Phone
# Get the current serial with: adb devices
# Wireless ADB usually looks like: 192.168.1.50:42069
JAZZ_ANDROID_PHONE_SERIAL=YOUR_PHONE_IP:PORT
JAZZ_ANDROID_PHONE_TOKEN=PASTE_PHONE_COMPANION_TOKEN_HERE

# Optional tablet. Leave blank if unused.
JAZZ_ANDROID_TABLET_SERIAL=
JAZZ_ANDROID_TABLET_TOKEN=

# Optional script/runtime overrides.
# The defaults below are normally correct on Windows.
JAZZ_POWERSHELL_PATH=powershell.exe
JAZZ_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# Optional custom folder containing allow-listed Jazz scripts.
# Default: <repo>\scripts\android
# JAZZ_SCRIPT_ROOT=C:\path\to\Jazz-AI-Assistant\scripts\android
