# Local development uses the Vite /api proxy, so this can stay blank.
VITE_API_BASE_URL=

# If the hosted web app calls the hosted API directly, set the HTTPS API origin
# at BUILD TIME and redeploy the static site, for example:
# VITE_API_BASE_URL=https://your-lost-mode-api.example
#
# Preferred on Render: leave this blank and add a Static Site rewrite from
# /api/* to https://your-lost-mode-server.onrender.com/api/* so browser auth
# remains same-origin and does not depend on third-party cookies.
#
# This variable is public and is baked into the Vite bundle. Never put a
# username, password, device credential, session token, or other secret here.
